    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let response = item.json.text ?? item.json.output ?? item.json.response;\n\n  if (typeof response !== 'string') {\n    response = JSON.stringify(response);\n  }\n\n  response = response\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  try {\n    const cleaned = JSON.parse(response);\n\n    return {\n      json: cleaned\n    };\n  } catch (error) {\n    throw new Error(\n      `Invalid JSON from AI: ${response}`\n    );\n  }\n});"
      },
